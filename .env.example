# ============================================================
# CONFIGURACIÓN GENERAL
# ============================================================

APP_NAME=data-processor
APP_ENV=development
# Puede modificarse a 'production' para entornos de producción.

# =============================================================================
# NASA/IPAC IRSA - ZTF Light Curve API
# =============================================================================

# Radio de búsqueda alrededor de las coordenadas del candidato.
# Se expresa en grados.
# 0.00042 grados equivalen aproximadamente a 1.512 segundos de arco.
# 0.0014 grados equivalen aproximadamente a 5.04 segundos de arco.
IRSA_SEARCH_RADIUS_DEGREES=0.00042

# Número mínimo de observaciones exigido para considerar una curva válida.
IRSA_MINIMUM_OBSERVATIONS=15

# Máscara de flags que IRSA debe excluir de la curva definitiva.
# 65535 excluye cualquier observación que tenga algún bit de catflags activo.
IRSA_BAD_CATALOG_FLAGS_MASK=65535

# Tiempo máximo de espera de cada petición HTTP, en segundos.
IRSA_REQUEST_TIMEOUT_SECONDS=60

# Tiempo mínimo entre peticiones consecutivas a IRSA, en segundos.
IRSA_REQUEST_DELAY_SECONDS=1.0

# Número máximo de intentos para errores temporales.
IRSA_MAX_RETRIES=5

# ============================================================
# CONFIGURACIÓN DEL LOGGER
# ============================================================

# Directorio donde se guardarán los archivos de log.
# La ruta se interpreta desde el directorio de ejecución.
LOG_DIR=logs

# Niveles disponibles:
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Número de archivos históricos que se conservarán.
LOG_RETENTION_DAYS=30

# true: fechas en UTC
# false: fechas según la zona horaria del sistema
LOG_UTC=false
LOG_TIMEZONE=Europe/Madrid

# ============================================================
# BASE DE DATOS
# ============================================================

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/kilo_hoku

# Número de conexiones permanentes del pool.
DATABASE_POOL_SIZE=5

# Número máximo de conexiones adicionales temporales.
DATABASE_MAX_OVERFLOW=10

# Segundos máximos de espera para obtener una conexión.
DATABASE_POOL_TIMEOUT=30

# Segundos tras los cuales se renueva una conexión.
DATABASE_POOL_RECYCLE=1800

# Comprueba que una conexión siga activa antes de utilizarla.
DATABASE_POOL_PRE_PING=true

# Muestra las consultas SQL en el sistema de logging de SQLAlchemy.
# En producción debería mantenerse en false.
DATABASE_ECHO=false