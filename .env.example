# ============================================================
# CONFIGURACIÓN GENERAL
# ============================================================

APP_NAME=data-processor
APP_ENV=development
# Puede modificarse a 'production' para entornos de producción.

# ============================================================
# CONFIGURACIÓN DEL LOGGER
# ============================================================

# Directorio donde se guardarán los archivos de log.
# La ruta se interpreta desde el directorio de ejecución.
LOG_DIR=logs

# Niveles disponibles:
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Número de archivos históricos que se conservarán.
LOG_RETENTION_DAYS=30

# true: fechas en UTC
# false: fechas según la zona horaria del sistema
LOG_UTC=true